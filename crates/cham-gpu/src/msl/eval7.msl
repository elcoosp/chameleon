// Standalone eval7 kernel — see eval7_shared.msl for the algorithm.
//
// Layout (matches what mtl.rs packs and what cham-gpu/src/kernels.rs
// produces from cham_core::eval::EvalTables):
//   buffer 0: uchar*  tables  (straight[8192] || seven_entries || flush_entries)
//   buffer 1: ulong*  hands   (one 6-bits-per-card packed hand each)
//   buffer 2: ushort* out     (dense rank per hand)
//   buffers 3-7: uint/ulong offsets and masks
//
// The shared file is concatenated above this one in Rust.

kernel void eval7_kernel(
    device const uchar*   tables       [[buffer(0)]],
    device const ulong*   hands        [[buffer(1)]],
    device       ushort*  out          [[buffer(2)]],
    constant     uint&    hand_count   [[buffer(3)]],
    constant     ulong&   seven_off    [[buffer(4)]],
    constant     ulong&   seven_mask   [[buffer(5)]],
    constant     ulong&   flush_off    [[buffer(6)]],
    constant     ulong&   flush_mask   [[buffer(7)]],
    uint tid [[thread_position_in_grid]])
{
    if (tid >= hand_count) return;
    out[tid] = eval7_msl(tables, seven_off, seven_mask,
                         flush_off, flush_mask, hands[tid]);
}
